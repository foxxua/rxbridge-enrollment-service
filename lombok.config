# Do not look for lombok.config files in parent directories
config.stopBubbling = true

# Mark generated code with @lombok.Generated (coverage tools skip it)
lombok.addLombokGeneratedAnnotation = true

# Forbidden features: the build fails if they are used
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.setter.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.val.flagUsage = error

# Copy @Qualifier from a field to the generated constructor parameter
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier